# Next.js / Vercel — canonical server-only variables
# The progress page only enables the Metabase section when all three are valid.
METABASE_SITE_URL=https://analytics.example.com
METABASE_PROGRESS_DASHBOARD_ID=1
METABASE_EMBED_SECRET=replace-with-the-guest-embedding-secret

# Backward-compatible aliases accepted by the app:
# METABASE_INSTANCE_URL=https://analytics.example.com
# METABASE_DASHBOARD_ID=1
#
# Do not use METABASE_JWT_SHARED_SECRET for the progress dashboard.
# Production uses Guest embedding + a locked user_id parameter.

# Local/self-hosted Metabase
METABASE_APP_DB_PASSWORD=replace-with-a-long-random-password
METABASE_PORT=3001
METABASE_IMAGE=metabase/metabase:v0.63.15.x
